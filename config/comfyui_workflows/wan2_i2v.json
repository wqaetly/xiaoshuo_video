{
  "_comment": "Wan 2.1 Image-to-Video 工作流 (480P, 适配 16GB VRAM)",
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "wan2.1_i2v_480p_bf16.safetensors",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
      "type": "wan"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "wan_2.1_vae.safetensors"
    }
  },
  "10": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "input.png"
    }
  },
  "11": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["2", 0],
      "text": "camera slowly panning, gentle movement"
    }
  },
  "12": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["2", 0],
      "text": "低质量, 模糊, 失真, 抖动, 噪点"
    }
  },
  "20": {
    "class_type": "WanImageToVideo",
    "inputs": {
      "positive": ["11", 0],
      "negative": ["12", 0],
      "vae": ["3", 0],
      "start_image": ["10", 0],
      "width": 832,
      "height": 480,
      "length": 81,
      "batch_size": 1
    }
  },
  "30": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["1", 0],
      "positive": ["20", 0],
      "negative": ["20", 1],
      "latent_image": ["20", 2],
      "seed": 0,
      "steps": 30,
      "cfg": 5.0,
      "sampler_name": "uni_pc",
      "scheduler": "normal",
      "denoise": 1.0
    }
  },
  "40": {
    "class_type": "VAEDecode",
    "inputs": {
      "vae": ["3", 0],
      "samples": ["30", 0]
    }
  },
  "50": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "images": ["40", 0],
      "frame_rate": 16,
      "loop_count": 0,
      "filename_prefix": "wan_video",
      "format": "video/h264-mp4",
      "pingpong": false,
      "save_output": true
    }
  }
}

